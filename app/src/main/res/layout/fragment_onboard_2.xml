<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E65100"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="120dp"
        android:layout_height="120dp"
        app:cardBackgroundColor="#FFF3E0"
        app:cardCornerRadius="60dp"
        app:cardElevation="6dp">

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:contentDescription="Ikon Pencarian"
            android:src="@android:drawable/ic_menu_search"
            app:tint="#E65100" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Cari Menu Favoritmu"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingExtra="4dp"
        android:text="Temukan berbagai pilihan mie ayam original, bakso, ceker pedas, hingga minuman segar secara instan lewat fitur pencarian."
        android:textAlignment="center"
        android:textColor="#FFE0B2"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="Geser ke kiri untuk lanjut ➔"
        android:textColor="#FFF3E0"
        android:textSize="12sp"
        android:textStyle="italic" />
</LinearLayout>